CHAT_APP_NAME="EXANTE Scenario Trainer"
CHAT_LLM_MODEL=gemma4:12b
CHAT_LLM_BASE_URL=http://localhost:11434/v1
# Required by the OpenAI-compatible SDK and ignored by local Ollama.
CHAT_LLM_API_KEY=ollama
CHAT_LLM_TIMEOUT_SECONDS=60
CHAT_SQLITE_PATH=./backend/data/chat.sqlite3
CHAT_CHAT_STORAGE_MODE=sqlite_vec
CHAT_HISTORY_WINDOW_MESSAGES=16
CHAT_SEMANTIC_MEMORY_LIMIT=6
CHAT_EMBEDDING_DIMENSIONS=64
CHAT_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Langfuse tracing and experiments:
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_RELEASE=git-sha-or-release-name
# Set false to run without exporting traces even when keys are present.
# LANGFUSE_TRACING_ENABLED=true

# OpenRouter (uses the same OpenAI-compatible client):
# CHAT_LLM_MODEL=openai/gpt-4o-mini
# CHAT_LLM_BASE_URL=https://openrouter.ai/api/v1
# CHAT_LLM_API_KEY=sk-or-v1-...
# CHAT_LLM_EXTRA_HEADERS='{"HTTP-Referer":"https://example.com","X-Title":"EXANTE Scenario Trainer"}'

# OpenAI or another OpenAI-compatible endpoint:
# CHAT_LLM_MODEL=gpt-4o-mini
# CHAT_LLM_BASE_URL=https://api.openai.com/v1
# CHAT_LLM_API_KEY=sk-...

# Offline/benchmark framework (`python -m evals.cli ...`). Values fall back to
# the matching CHAT_LLM_* settings when omitted.
# EVAL_CLIENT_MODEL=gemma4:12b
# EVAL_JUDGE_MODEL=gpt-4o-mini
# EVAL_CLIENT_BASE_URL=http://localhost:11434/v1
# EVAL_JUDGE_BASE_URL=https://api.openai.com/v1
# EVAL_CLIENT_API_KEY=ollama
# EVAL_JUDGE_API_KEY=sk-...
# EVAL_SYSTEM_PROMPT_PATH=./backend/agent/customer.md
# EVAL_PROMPT_VERSION=client_v1
# EVAL_CONCURRENCY=5
# EVAL_TIMEOUT_SECONDS=60
# EVAL_RETRIES=2
# EVAL_REPLY_MAX_CHARS=1200
# EVAL_INTENTIONS_MAX_CHARS=2000
# EVAL_PERSONA_THRESHOLD=4
# EVAL_REALISM_THRESHOLD=4
# EVAL_CONSISTENCY_THRESHOLD=4
# EVAL_INTENTIONS_THRESHOLD=2
# EVAL_CONVERSATION_THRESHOLD=4
# EVAL_QUALITY_REGRESSION_THRESHOLD=0.05
# EVAL_SCORE_REGRESSION_THRESHOLD=0.25
# EVAL_LANGFUSE_ENABLED=true
